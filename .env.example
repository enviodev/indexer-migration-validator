# Subgraph GraphQL endpoint
SUBGRAPH_URL=https://api.thegraph.com/subgraphs/name/your-subgraph

# HyperIndex GraphQL endpoint
HYPERINDEX_URL=https://your-indexer.hyperindex.xyz/v1/graphql

# Path to subgraph schema file (default: ./subgraph-schema.graphql)
SUBGRAPH_SCHEMA=./subgraph-schema.graphql

# Path to hyperindex schema file (default: ./hyperindex-schema.graphql)
HYPERINDEX_SCHEMA=./hyperindex-schema.graphql

# Path to overrides file for field mappings (default: ./overrides.json)
OVERRIDES_PATH=./overrides.json
