{
  "name": "indexer-migration-validator",
  "version": "1.0.0",
  "description": "Compare subgraph vs HyperIndex GraphQL results to validate indexer migrations",
  "type": "module",
  "scripts": {
    "compare": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:user": "tsx test-user-query.ts",
    "test:entities": "tsx test-user-marketplace.ts",
    "introspect": "tsx introspect-hyperindex.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
